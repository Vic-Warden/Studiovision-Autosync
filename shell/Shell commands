    powershell -WindowStyle Hidden -Command "[System.Reflection.Assembly]::LoadWithPartialName('System.Windows.Forms') | Out-Null; [System.Windows.Forms.MessageBox]::Show('The image router is already running. Check the taskbar (bottom right).', 'Already open', 'OK', 'Information')"
